---
import MainLayout from "../layouts/MainLayout.astro";
import { getPageMeta, loadContent } from "../lib/content";

const meta = getPageMeta("writing-guides");
const body = loadContent("writing-guides");
---

<MainLayout currentPage={meta.currentPage} pageTitle={meta.pageTitle} metaDescription={meta.metaDescription}>
  <Fragment set:html={body} />
</MainLayout>
