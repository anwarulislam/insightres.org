---
interface Props {
  currentPage?: string;
  pageTitle?: string;
  metaDescription?: string;
}

const {
  currentPage = "",
  pageTitle = "Insight Research | Premium Content Writing & Business Consultancy",
  metaDescription =
    "Transform your ideas into compelling content. Insight Research delivers pro-level writing, research, and consulting services tailored to your needs."
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" type="image/png" href="/images/insight-res-logo-144x144.png" />
  </head>
  <body>
    <div class="bg-gradient"></div>
    <div class="bg-grid"></div>

    <header class="header">
      <nav class="nav container">
        <a href="/" class="logo">
          <img
            src="/images/insight-res-logo-300x300.png"
            alt="Insight Research Logo"
            width="48"
            height="48"
            class="logo-image"
          />
        </a>
        <button class="menu-toggle" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <ul class="nav-links">
          <li><a href="/" class={currentPage === "home" ? "active" : undefined}>Home</a></li>
          <li><a href="/blog" class={currentPage === "blog" ? "active" : undefined}>Blog</a></li>
          <li>
            <a href="/case-studies" class={currentPage === "case-studies" ? "active" : undefined}
              >Case Studies</a
            >
          </li>
          <li><a href="/faq" class={currentPage === "faq" ? "active" : undefined}>FAQ</a></li>
          <li>
            <a href="/#contact" class="btn btn-primary btn-nav">Get Started</a>
          </li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-glow"></div>
      <div class="container">
        <div class="footer-main">
          <div class="footer-brand">
            <a href="/" class="logo">
              <img src="/images/insight-res-logo-300x300.png" alt="Insight Research Logo" width="48" height="48" class="logo-image" />
            </a>
            <p>
              Transforming ideas into compelling content that drives results.
              Your trusted partner for premium writing and research services.
            </p>
            <div class="footer-social">
              <a href="#" aria-label="Medium" class="footer-social-link">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"
                  />
                </svg>
              </a>
              <a href="#" aria-label="Facebook" class="footer-social-link">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                  />
                </svg>
              </a>
              <a href="#" aria-label="LinkedIn" class="footer-social-link">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                  />
                </svg>
              </a>
              <a href="#" aria-label="Twitter" class="footer-social-link">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                  />
                </svg>
              </a>
            </div>
          </div>

          <div class="footer-links-grid">
            <div class="footer-column">
              <h4>Company</h4>
              <ul>
                <li><a href="/#about">About Us</a></li>
                <li><a href="/#services">Our Services</a></li>
                <li><a href="/#process">How It Works</a></li>
                <li><a href="/#pricing">Pricing</a></li>
                <li><a href="/#contact">Contact</a></li>
              </ul>
            </div>
            <div class="footer-column">
              <h4>Services</h4>
              <ul>
                <li><a href="/#services">Content Writing</a></li>
                <li><a href="/#services">Copywriting</a></li>
                <li><a href="/#services">Business Research</a></li>
                <li><a href="/#services">SEO Content</a></li>
                <li><a href="/#services">Consulting</a></li>
              </ul>
            </div>
            <div class="footer-column">
              <h4>Resources</h4>
              <ul>
                <li><a href="/blog">Blog</a></li>
                <li><a href="/case-studies">Case Studies</a></li>
                <li><a href="/writing-guides">Writing Guides</a></li>
                <li><a href="/faq">FAQ</a></li>
              </ul>
            </div>
            <div class="footer-column">
              <h4>Contact</h4>
              <ul class="footer-contact-list">
                <li>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                    />
                    <polyline points="22,6 12,13 2,6" />
                  </svg>
                  <a href="mailto:hello@insightres.org">hello@insightres.org</a>
                </li>
                <li>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  <span>Worldwide Remote</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <div class="footer-bottom-left">
            <p>&copy; {year} Insight Research. All rights reserved.</p>
          </div>
          <div class="footer-bottom-center">
            <span class="footer-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
              Secure & Confidential
            </span>
          </div>
          <div class="footer-bottom-right">
            <a href="/privacy-policy">Privacy Policy</a>
            <span class="footer-divider"></span>
            <a href="/terms-of-service">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline src="/script.js"></script>
  </body>
</html>
